[user]
	name = Kevin Bi
	email = kevinbi075@gmail.com
	signingkey = ~/.ssh/id_ed25519.pub
[init]
	defaultBranch = main
[core]
	editor = vim
[commit]
	gpgsign = true
	verbose = true
[gpg]
	format = ssh
[fetch]
	prune = true
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[rebase]
	updateRefs = true
	autoStash = true
	autoSquash = true
[merge]
	conflictStyle = zdiff3
[diff]
	algorithm = histogram
	colorMoved = default
[rerere]
	enabled = true
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[help]
	autocorrect = prompt

# Machine-specific overrides (work email, signing program, credentials, ...).
# Keep this last so it wins over everything above.
[include]
	path = ~/.gitconfig.local
